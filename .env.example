# Copy this file to .env for local development (with `vercel dev`)
# and add the same keys under Vercel → Project → Settings → Environment Variables for deployment.

# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/communityconnect?retryWrites=true&w=majority

# Any long random string — used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Optional: only needed if you split the API into its own deployment.
# Leave unset when frontend + API live in the same Vercel project.
# VITE_API_URL=
